#!/usr/bin/env bash
# Reject commits on branches that do not follow docs/branches.md.
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=.githooks/lib/branch-name.sh
source "$hook_dir/lib/branch-name.sh"

branch="$(git symbolic-ref --quiet --short HEAD || true)"
# Detached HEAD (rebase, merge, CI checkout): nothing to validate.
[[ -z "$branch" ]] && exit 0

validate_branch "$branch"
