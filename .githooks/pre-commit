#!/usr/bin/env bash
# Reject commits on branches that do not follow docs/branches.md and run the
# quality gate (lint, typecheck, tests).
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=.githooks/lib/branch-name.sh
source "$hook_dir/lib/branch-name.sh"

branch="$(git symbolic-ref --quiet --short HEAD || true)"
# Detached HEAD (rebase, merge, CI checkout): skip branch-name validation.
if [[ -n "$branch" ]]; then
  validate_branch "$branch"
fi

# Quality gate: delegates to the sandbox when run on the host.
make verify
